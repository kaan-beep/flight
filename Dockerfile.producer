FROM python:3.11-slim

WORKDIR /app

# Dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Producer code
COPY producer.py .

CMD ["python", "producer.py"]
